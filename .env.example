# ============================================================
# Edge AI Trainer — environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ============================================================

# --- General ---
EAT_ENV=local                          # local | ci | cloud
EAT_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
EAT_ARTIFACTS_DIR=./artifacts          # checkpoints, exports, eval reports
EAT_RUNS_DIR=./runs                    # per-run scratch dirs (logs, intermediate)
EAT_CACHE_DIR=./.cache/eat

# --- HF / model download ---
HF_HOME=./.cache/huggingface
HUGGING_FACE_HUB_TOKEN=                # required for gated models (Gemma 3n is gated)
TRANSFORMERS_OFFLINE=0

# --- Orchestrator ---
EAT_ORCHESTRATOR_HOST=127.0.0.1
EAT_ORCHESTRATOR_PORT=8765
EAT_DB_URL=sqlite:///./eat.sqlite      # SQLAlchemy URL
EAT_REDIS_URL=redis://127.0.0.1:6379/0
EAT_QUEUE_GPU=eat.gpu
EAT_QUEUE_CPU=eat.cpu
EAT_QUEUE_ANDROID=eat.android
EAT_QUEUE_CLOUD=eat.cloud
EAT_GPU_WORKERS=1                      # never >1 on a single-GPU machine
EAT_CPU_WORKERS=4
EAT_ANDROID_WORKERS=1

# --- Dashboard ---
EAT_DASHBOARD_HOST=127.0.0.1
EAT_DASHBOARD_PORT=8501

# --- MLflow ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_ARTIFACT_LOCATION=./mlartifacts
MLFLOW_EXPERIMENT_DEFAULT=edge-ai-trainer

# --- Data-gen teacher (synthetic data; optional) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EAT_TEACHER_PROVIDER=anthropic         # anthropic | openai | none
EAT_TEACHER_MODEL=claude-opus-4-7
EAT_TEACHER_MAX_USD=25                 # hard cap per data-gen job

# --- LLM-as-judge (eval) ---
EAT_JUDGE_PROVIDER=anthropic           # anthropic | openai | local
EAT_JUDGE_MODEL=claude-sonnet-4-6
EAT_JUDGE_MAX_USD=10

# --- Android ---
ADB_BIN=adb
EAT_ANDROID_DEVICE_SERIAL=             # set to a specific device serial, or empty for first available
EAT_ANDROID_REMOTE_DIR=/data/local/tmp/eat
EAT_ANDROID_APP_ID=com.eat.bench
EAT_ANDROID_BENCH_TIMEOUT_S=600

# --- Cloud serving ---
EAT_CONTAINER_REGISTRY=ghcr.io/your-org/eat
EAT_DEFAULT_CLOUD_PLATFORM=modal       # modal | runpod | fly | cloud_run | k8s

# Modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# RunPod
RUNPOD_API_KEY=

# Fly.io
FLY_API_TOKEN=

# Generic object store for model artifacts (optional)
EAT_ARTIFACT_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --- Cloud training (SkyPilot) ---
EAT_SKYPILOT_DEFAULT_CLOUD=runpod      # runpod | lambda | aws | gcp | azure
EAT_CLOUD_TRAIN_MAX_USD=50             # hard cap per cloud training job
EAT_CLOUD_TRAIN_MAX_HOURS=24

# --- DVC remote (optional dataset storage) ---
EAT_DVC_REMOTE=
